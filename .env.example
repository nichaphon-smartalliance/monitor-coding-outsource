# ===== AI Gateway (develyst-ai) =====
# URL ของ develyst-ai gateway (รัน `bun run dev` ในโฟลเดอร์ develyst-ai ก่อน)
AI_GATEWAY_URL=http://localhost:3009
# provider เจาะจง (ว่าง = ใช้ fallback chain: deepseek->xai->gemini->openai)
AI_PROVIDER=
# model เจาะจง (ว่าง = ใช้ default ของ provider)
AI_MODEL=
# token สูงสุดต่อการเรียก 1 ครั้ง (วิเคราะห์โค้ดควรสูงหน่อย)
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_TIMEOUT=120000

# ===== Repo ที่จะตรวจ (โค้ด outsource) =====
# path ไป repo ที่เก็บโค้ดรายเดือน (แต่ละเดือน = 1 branch). ว่าง = โฟลเดอร์ปัจจุบัน
TARGET_REPO=

# ภาษาของรายงาน/อีเมล: th หรือ en
REPORT_LANGUAGE=th

# ===== Microsoft Graph (ส่งอีเมล) =====
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
# กล่องเมลผู้ส่ง (ต้องมีสิทธิ์ Mail.Send แบบ application ใน Azure)
MS_SENDER_EMAIL=support@smartalliance.co.th
# ผู้รับ (คั่นด้วย comma)
EMAIL_TO=
EMAIL_CC=
# false = โหมดทดสอบ (สร้างรายงานแต่ไม่ส่งจริง), true = ส่งจริง
EMAIL_SEND_ENABLED=false
