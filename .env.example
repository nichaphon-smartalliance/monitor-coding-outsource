# ===== AI Gateway (develyst-ai) =====
# URL ของ develyst-ai gateway (server: https://ai.develyst.online หรือ local: http://localhost:3009)
AI_GATEWAY_URL=https://ai.develyst.online
# provider/model global เจาะจง (ปกติเว้นว่าง แล้วให้ pipeline ด้านล่างกำหนดต่อสเตจ)
AI_PROVIDER=
AI_MODEL=
# token สูงสุดต่อการเรียก 1 ครั้ง
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_TIMEOUT=120000

# ===== Pipeline หลายสเตจ =====
# รูปแบบ: "provider" หรือ "provider:model"; chain คั่นด้วย comma (เว้นว่าง = ให้ gateway fallback)
# tier ช่วยจำ: small=เร็ว/ถูก  medium=สมดุล (เหมาะวิเคราะห์โค้ด+เขียน)  flagship=งานยากสุด
# Stage 1: เข้าใจ docs — context ใหญ่ ราคาถูก
AI_CONTEXT_MODEL=gemini:gemini-2.5-flash
# Stage 2: วิเคราะห์โค้ดรายไฟล์ แบบ refine chain — โมเดลแรก draft, ตัวถัด ๆ ตรวจทาน/แก้
#   ใส่หลาย provider เพื่อ cross-check (เปลือง token ขึ้น) หรือเหลือตัวเดียวเพื่อความเร็ว
AI_ANALYZE_CHAIN=deepseek:deepseek-chat,xai:grok-3,openai:gpt-4.1-mini
# Stage 3: เรียบเรียงสรุป/อีเมล — ระดับกลางที่เขียนดี (ไม่ต้องใช้ flagship ก็พอ)
AI_WRITER_MODEL=gemini:gemini-2.5-flash

# ===== Repo ที่จะตรวจ (โค้ด outsource) =====
# path ไป repo ที่เก็บโค้ดรายเดือน (แต่ละเดือน = 1 branch). ว่าง = โฟลเดอร์ปัจจุบัน
TARGET_REPO=

# ภาษาของรายงาน/อีเมล: th หรือ en
REPORT_LANGUAGE=th

# ===== Microsoft Graph (ส่งอีเมล) =====
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
# กล่องเมลผู้ส่ง (ต้องมีสิทธิ์ Mail.Send แบบ application ใน Azure)
MS_SENDER_EMAIL=support@smartalliance.co.th
# ผู้รับ (คั่นด้วย comma)
EMAIL_TO=
EMAIL_CC=
# false = โหมดทดสอบ (สร้างรายงานแต่ไม่ส่งจริง), true = ส่งจริง
EMAIL_SEND_ENABLED=false
